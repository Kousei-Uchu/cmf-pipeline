# ---------------------------------------------------------------------------
# spotify-down server configuration
# Copy this file to .env and fill in the values you need.
# Every variable below is optional — sensible defaults are used if unset.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------

# Port the server listens on.
# Default: 8787
PORT=8787

# Host/interface the server binds to.
# Default: 127.0.0.1
HOST=127.0.0.1

# --- Logging ----------------------------------------------------------------

# Log verbosity: error | warn | info | debug
# Default: info (or debug if DEBUG is set)
LOG_LEVEL=info

# Set to any truthy value to force debug-level logging.
# Default: unset
DEBUG=

# --- Spotify API ------------------------------------------------------------
# Required for resolving Spotify track/playlist metadata.
# Create an app at https://developer.spotify.com/dashboard to get these.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Genius API ---------------------------------------------------------
# Enables searching for official music videos via Genius. Optional, but recommended for better results.
# Get a token at https://genius.com/api-clients

GENIUS_ACCESS_TOKEN=

# --- yt-dlp ---------------------------------------------------------------

# Path to the yt-dlp binary.
# Default: yt-dlp (resolved from PATH)
YTDLP_PATH=

# Number of concurrent fragment downloads per yt-dlp job.
# Default: 4
YTDLP_CONCURRENT_FRAGMENTS=4

# Use aria2c as the external downloader for yt-dlp. Set to 0 to disable.
# Default: enabled (any value other than "0")
USE_ARIA2C=1

# Number of connections aria2c opens per download (only used if USE_ARIA2C is enabled).
# Default: 8
ARIA2C_CONNECTIONS=8

# --- ffmpeg / ffprobe -------------------------------------------------------

# Path to the ffmpeg binary.
# Default: ffmpeg (resolved from PATH)
FFMPEG_PATH=

# Path to the ffprobe binary.
# Default: ffprobe (resolved from PATH)
FFPROBE_PATH=

# AV1 video encoder to use (e.g. libsvtav1, av1_nvenc).
# Default: libsvtav1
AV1_ENCODER=libsvtav1

# AV1 constant rate factor (quality). Lower = higher quality/larger file.
# Default: 20
AV1_CRF=20

# AV1 encoder preset. Meaning depends on AV1_ENCODER
# (e.g. 0-13 for libsvtav1, p1-p7 for av1_nvenc).
# Default: 4 (or p5 when AV1_ENCODER=av1_nvenc)
AV1_PRESET=4

# Opus audio bitrate for transcoded output.
# Default: 128k
OPUS_BITRATE=128k

# --- Job processing -----------------------------------------------------

# Number of download/export jobs processed concurrently.
# Default: 3
JOB_CONCURRENCY=3

# Hours an exported file is kept before being cleaned up.
# Default: 24
EXPORT_TTL_HOURS=24

# --- Matching thresholds -----------------------------------------------
# Minimum similarity scores (0-1) used when matching a Spotify track
# to a YouTube video. Lower values are more permissive.

# Overall match score threshold.
# Default: 0.55
MIN_VIDEO_MATCH_SCORE=0.55

# Keyword-only match score threshold.
# Default: 0.35
MIN_VIDEO_KEYWORD_SCORE=0.35
