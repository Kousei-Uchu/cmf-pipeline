PORT=8787
# Bind 127.0.0.1 for local-only, or 0.0.0.0 so other devices on your LAN can use export URLs.
HOST=127.0.0.1

# Optional. Enables Spotify URL resolution, catalog search, and richer album/artist metadata.
# Create an app at https://developer.spotify.com/dashboard — Client Credentials only (no user login).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional overrides if yt-dlp / ffmpeg are not on PATH
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# How long export URLs stay valid (hours)
EXPORT_TTL_HOURS=24
